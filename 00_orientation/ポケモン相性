def is_hiragana_or_katakana(text):
    if text == "":
        return False

    for ch in text:
        if not (
            ("ぁ" <= ch <= "ん") or
            ("ァ" <= ch <= "ヶ") or
            ch == "ー"
        ):
            return False

    return True


def validate_type(type_name, label, allow_empty=False):
    if type_name == "":
        if allow_empty:
            return None
        else:
            return f"{label}を入力してください。"

    if not is_hiragana_or_katakana(type_name):
        return f"{label}は、ひらがなまたはカタカナで入力してください。"

    if type_name not in type_chart:
        return f"{label}に存在しないタイプが入力されています。"

    return None


def get_effectiveness(attack_type, defense_types):
    total = 1

    for defense_type in defense_types:
        damage = type_chart[attack_type].get(defense_type, 1)
        total *= damage

    return total


def get_message(result):
    if result == 4:
        return "効果はちょうばつぐんだ！"
    elif result == 2:
        return "効果はばつぐんだ！"
    elif result == 1:
        return "通常の効果"
    elif result == 0.5:
        return "効果はいまひとつのようだ..."
    elif result == 0.25:
        return "効果はとてもいまひとつのようだ..."
    elif result == 0:
        return "効果がないようだ..."
    else:
        return "判定できませんでした"


